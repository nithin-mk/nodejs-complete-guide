MONGODB_URI=mongodb://127.0.0.1:27017/shop
SESSION_SECRET=change-me-in-production

# Public base URL of this app, used to build absolute links in emails
# (e.g. the password-reset link). Set to your real domain in production.
APP_BASE_URL=http://localhost:3000

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nodejs-complete-guide

STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me

SENDGRID_API_KEY=SG.replace_me
SENDGRID_FROM_EMAIL=your-verified-sender@example.com
